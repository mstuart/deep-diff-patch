{
	"name": "deep-diff-patch",
	"version": "1.0.0",
	"description": "Compute a minimal JSON-serializable diff between objects and apply it as a patch",
	"license": "MIT",
	"repository": "mstuart/deep-diff-patch",
	"funding": "https://github.com/sponsors/mstuart",
	"author": {
		"name": "Mark Stuart",
		"email": "mstuart@users.noreply.github.com",
		"url": "https://github.com/mstuart"
	},
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "ava && tsd",
		"check": "ultracite check",
		"fix": "ultracite fix"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"diff",
		"patch",
		"json",
		"deep",
		"compare",
		"rfc6902",
		"object",
		"delta",
		"merge"
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"ava": "^8.0.1",
		"tsd": "^0.33.0",
		"ultracite": "7.10.2"
	}
}
